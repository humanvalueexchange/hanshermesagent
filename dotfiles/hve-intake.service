[Unit]
Description=HVE Intake Pipeline — Index new PDFs into LanceDB

[Service]
Type=oneshot
Slice=hve-knowledge.slice
WorkingDirectory=/opt/hve-knowledge-layer/current
Environment=PYTHONPATH=/opt/hve-knowledge-layer/current/src
Environment=HVE_KNOWLEDGE_CONFIG=/opt/hve-knowledge-layer/current/config/knowledge-layer/knowledge-layer.yaml
ExecStart=/home/hans/.hve-knowledge/venv/bin/python3 -m hve_knowledge_layer.cli --root /hve-library intake
StandardOutput=journal
StandardError=journal
Environment=CUDA_VISIBLE_DEVICES=

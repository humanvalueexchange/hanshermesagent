[Unit]
Description=HVE Hermes MCP Server
Documentation=https://github.com/humanvalueexchange/hanshermesagent
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/hanshermesagent
# Kill any orphaned process holding port 8765 before starting (prevents crash loop)
ExecStartPre=-/usr/bin/fuser -k 8765/tcp
ExecStart=%h/.hermes-mcp-venv/bin/python %h/hanshermesagent/mcp/server.py
EnvironmentFile=-%h/.hermes-mcp.env
Environment="HVE_MCP_HOST=127.0.0.1"
Environment="HVE_MCP_PORT=8765"
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=hermes-mcp

[Install]
WantedBy=default.target

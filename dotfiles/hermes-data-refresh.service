[Unit]
Description=Hermes — Daily Kraken BTC Market Data Refresh
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=oneshot
User=hans
WorkingDirectory=/home/hans/freqtrade
# Wait up to 2 minutes for Kraken to be reachable (handles post-boot network delays)
ExecStartPre=/bin/sh -c 'for i in $(seq 1 12); do curl -sf --max-time 5 "https://api.kraken.com/0/public/Ticker?pair=XXBTZUSD" && exit 0; echo "Waiting for Kraken ($i/12)..."; sleep 10; done; echo "Kraken unreachable after 2min — aborting"; exit 1'
ExecStart=/home/hans/freqtrade/.venv/bin/freqtrade download-data \
  --exchange kraken \
  --pairs BTC/USD \
  --timeframes 1m 5m 15m 1h 4h 1d \
  --dl-trades \
  --days 7 \
  --datadir /home/hans/freqtrade/user_data/data
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

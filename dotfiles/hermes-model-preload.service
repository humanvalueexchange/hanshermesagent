[Unit]
Description=Hermes Model Preload — keeps the approved local Ollama stack hot
Documentation=https://github.com/humanvalueexchange/hermes-cfo
After=network-online.target
Requires=ollama.service
After=ollama.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash %h/hermes-cfo/scripts/hermes-preload-models.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=300

[Install]
WantedBy=default.target

[Unit]
Description=Hermes Model Preload — keeps the approved local Ollama stack hot
Documentation=https://github.com/humanvalueexchange/hanshermesagent
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/bash %h/hanshermesagent/scripts/hermes-preload-models.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=300

[Install]
WantedBy=default.target
